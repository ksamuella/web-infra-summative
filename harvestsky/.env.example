# Copy to .env for local use. NEVER commit the real .env (it is git-ignored).

# Free key from https://home.openweathermap.org/api_keys (new keys can take up to 2 hours to activate)
OPENWEATHER_API_KEY=

# Signs login cookies. Must be identical on both web servers. Generate: openssl rand -hex 32
AUTH_SECRET=

# Authenticates server-to-server account replication. Identical on both servers. Generate: openssl rand -hex 24
SYNC_SECRET=

PORT=3000
HOST=127.0.0.1
SERVER_NAME=local

# Used on the real servers (set by deploy/deploy.sh):
# PEERS=http://10.0.0.12
# TRUST_PROXY=1
# DB_PATH=/var/lib/harvestsky/harvestsky.db
# CACHE_TTL_SECONDS=1800
