# Copy to .env for local use (never commit the real .env).
# The USGS API is public and needs no key, so nothing secret is required.
PORT=3000
HOST=127.0.0.1
# Name shown in the "Served by" badge. On the servers this is web-01 / web-02.
SERVER_NAME=local
CACHE_TTL_SECONDS=120
RATE_LIMIT_PER_MIN=300
